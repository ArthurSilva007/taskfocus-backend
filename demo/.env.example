# ═══════════════════════════════════════════════════════════════════════
# 🔐 TASKFOCUS - VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO & DESENVOLVIMENTO
# ═══════════════════════════════════════════════════════════════════════
PORT=8080
SPRING_APPLICATION_NAME=taskfocus
# BANCO DE DADOS - SENSÍVEL
SPRING_DATASOURCE_URL=postgresql://seu_usuario:sua_senha@seu_host:5432/seu_database
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_super_segura_aqui
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# JWT - SENSÍVEL
JWT_SECRET=gere_uma_chave_aleatoria_com_32_caracteres_minimo
JWT_EXPIRATION=86400000
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173
# EMAIL - SENSÍVEL
MAIL_HOST=smtp.mailersend.net
MAIL_PORT=2525
MAIL_USERNAME=seu_usuario_mailersend_aqui
MAIL_PASSWORD=sua_senha_mailersend_aqui
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# LOGGING
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_SECURITY=DEBUG
# ACTUATOR
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
# JPA / HIBERNATE
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_SQL_INIT_MODE=never
