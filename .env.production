# TASKFOCUS - RAILWAY PRODUCTION TEMPLATE
# Use this file as a reference/template. Do not commit real secrets.

# Application
SPRING_APPLICATION_NAME=taskfocus
PORT=8084

# Database
# Preferred: set ONE source of truth only.
# Option A: set DATABASE_URL from Railway and let docker-entrypoint.sh translate it.
# DATABASE_URL={{ Postgres-bUoN.DATABASE_URL }}

# Option B: set a clean JDBC URL manually.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-buon.railway.internal:5432/railway
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_RAILWAY_POSTGRES_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JWT
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:4200,http://localhost:3000,http://localhost:5173

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_SQL_INIT_MODE=never

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_SECURITY=INFO

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# Multipart
SPRING_SERVLET_MULTIPART_ENABLED=true
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# Railway auto-generated variables for reference only:
# DATABASE_PUBLIC_URL=postgresql://user:password@public-host:port/railway
# DATABASE_URL=postgresql://user:password@postgres-buon.railway.internal:5432/railway
# PGDATABASE=railway
# PGHOST=postgres-buon.railway.internal
# PGPORT=5432
# PGUSER=postgres
